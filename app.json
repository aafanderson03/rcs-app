{
  "expo": {
    "name": "RCS Employee",
    "slug": "rcs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rcs-app-icon.png",
    "scheme": "rcsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/rcs-app-icon.png"
    },
    "android": {
      "backgroundColor": "#F8F6F1",
      "adaptiveIcon": {
        "backgroundColor": "#E7B83F",
        "foregroundImage": "./assets/images/rcs-android-foreground.png",
        "monochromeImage": "./assets/images/rcs-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/rcs-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-prototype-http-portal",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F1",
          "image": "./assets/images/rcs-supermarket-logo.png",
          "imageWidth": 170
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
